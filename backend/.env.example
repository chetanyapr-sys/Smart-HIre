# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smarthire?retryWrites=true&w=majority

# JWT signing secret (kuch bhi random, strong string rakho)
SECRET_KEY=change-this-to-a-long-random-string

# Frontend ka URL (CORS ke liye, production me localhost nahi hoga)
FRONTEND_URL=http://localhost:3000

FLASK_ENV=production
PORT=5000